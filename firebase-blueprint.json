{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with Google auth data and game stats",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "gamesPlayed": { "type": "number" },
        "gamesWon": { "type": "number" },
        "totalScore": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "displayName"]
    },
    "GameRoom": {
      "title": "GameRoom",
      "description": "Taboo stormio game room data",
      "type": "object",
      "properties": {
        "roomCode": { "type": "string" },
        "hostId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["roomCode", "hostId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User account document"
    },
    "/rooms/{roomCode}": {
      "schema": { "$ref": "#/entities/GameRoom" },
      "description": "Multiplayer game room document"
    }
  }
}
